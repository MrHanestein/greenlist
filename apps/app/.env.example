# Production uses managed PostgreSQL. Local development can use npm run db:local.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres?connection_limit=1&statement_cache_size=0
APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Create a GBP 15.00 monthly price and enable cancellation at period end in the portal.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
# Generate independent random values of at least 32 characters.
CRON_SECRET=
AUTOFILL_API_TOKEN_SECRET=
# Set approved only after confirming commercial display rights and quotas.
ADZUNA_COMMERCIAL_USE_APPROVED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_MAX_PAGES=2
# Each board is explicitly reviewed. Example structure, not an enabled source:
# [{"token":"employer-token","company":"Exact legal employer name","approved":true}]
GREENHOUSE_BOARDS=[]
# Optional opt-in email alerts. Set up a verified sender.
RESEND_API_KEY=
ALERT_FROM=

# Paid pilot stays disabled until external release gates have passed.
PAID_PILOT_ENABLED=false
ADMIN_CLERK_IDS=
LEVER_BOARDS=[]
ANTHROPIC_API_KEY=
# Set a currently available model ID and verified GBP-equivalent token prices.
ANTHROPIC_MODEL=
AI_INPUT_GBP_PER_MILLION=
AI_OUTPUT_GBP_PER_MILLION=
AI_MONTHLY_BUDGET_GBP=50

# Use a PRIVATE Vercel Blob store, never a public store for CVs.
BLOB_READ_WRITE_TOKEN=

BUSINESS_NAME=
BUSINESS_ADDRESS=
SUPPORT_EMAIL=

# Use the official logo supplied/approved by Adzuna; required before importing.
NEXT_PUBLIC_ADZUNA_LOGO_URL=

# Set only after the actual business-model review is completed.
BUSINESS_MODEL_REVIEWED=false
# Optional Discord invite, after human moderation is ready.
NEXT_PUBLIC_COMMUNITY_URL=
